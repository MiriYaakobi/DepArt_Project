<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivery System Login" Height="550" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Images/logo.png"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="TextDark" Color="#4A4A6A"/>
        <SolidColorBrush x:Key="GhostWhite" Color="#F8F8FF"/>

        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepPurple}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox" x:Key="PassBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepPurple}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Border" x:Key="LoginCard">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{StaticResource GhostWhite}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8986CC" BlurRadius="25" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="LoginButtonStyle">
            <Setter Property="Background" Value="{StaticResource DeepPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="100" CenterY="22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="50" Width="30" Height="30">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E0"/>
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource LoginCard}" Margin="30">
            <Grid>
                <Button Style="{StaticResource CloseBtnStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" IsCancel="True"
                        Command="{Binding ExitCommand}"/>

                <StackPanel Margin="40,20,40,40" VerticalAlignment="Center">

                    <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,15"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="/Images/logo.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Please login to continue" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Identity Number" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,5"/>

                    <TextBox Style="{StaticResource InputBox}" Margin="0,0,0,15" MaxLength="9" 
                             Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="TxtId_PreviewTextInput"/>

                    <TextBlock Text="Password" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,5"/>

                    <PasswordBox x:Name="pbPassword" Style="{StaticResource PassBox}" Margin="0,0,0,30"/>

                    <Button Content="Login" Style="{StaticResource LoginButtonStyle}"
                            Command="{Binding LoginCommand}" IsDefault="True"
                            CommandParameter="{Binding ElementName=pbPassword}"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>