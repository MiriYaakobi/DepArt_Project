<Window x:Class="PL.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="400" 
        SizeToContent="Height" MinHeight="160"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.1" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#8986CC" CornerRadius="8,0,0,8"/>

            <Grid Grid.Column="1" Margin="25,30,25,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock x:Name="txtIcon" Text="ℹ️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTitle" Text="Notification" 
                               Foreground="#333333" FontSize="19" FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="txtMessage" 
                           Text="Message content goes here..." 
                           Foreground="#555555" FontSize="15" TextWrapping="Wrap" 
                           LineHeight="22"
                           Margin="0,0,0,30"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnYes" Content="OK" Click="BtnYes_Click"
                            Width="85" Height="34" FontSize="14" FontWeight="SemiBold"
                            Background="#8986CC" Foreground="White" 
                            BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnNo" Content="Cancel" Click="BtnNo_Click" Visibility="Collapsed"
                            Width="85" Height="34" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                            Background="White" Foreground="#555555" 
                            BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>