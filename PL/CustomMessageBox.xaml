<Window x:Class="PL.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" Background="#F8F8FF" BorderBrush="#8986CC" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#8986CC" CornerRadius="18,18,0,0">
                <TextBlock x:Name="txtTitle" Text="Notification" Foreground="White" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                           FontSize="18" FontWeight="Bold"/>
            </Border>

            <TextBlock Grid.Row="1" x:Name="txtMessage" Text="Message goes here..." 
                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                       TextWrapping="Wrap" Margin="20" FontSize="16" Foreground="#4A4A6A"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="btnYes" Content="OK" Click="BtnYes_Click"
                        Width="100" Height="35" Margin="10,0"
                        Background="#8986CC" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnNo" Content="No" Click="BtnNo_Click" Visibility="Collapsed"
                        Width="100" Height="35" Margin="10,0"
                        Background="#FFF5EE" Foreground="#8986CC" FontWeight="Bold"
                        BorderThickness="2" BorderBrush="#8986CC" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>