<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:PL="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Delivery System Dashboard" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FlowDirection="LeftToRight"
        Loaded="Window_Loaded"
        Icon="/Images/logo.png"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="GhostWhite" Color="#F8F8FF"/>
        <SolidColorBrush x:Key="AliceBlue" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="Seashell" Color="#FFF5EE"/>
        <SolidColorBrush x:Key="Lavender" Color="#E6E6FA"/>
        <SolidColorBrush x:Key="TextDark" Color="#4A4A6A"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <PL:SimulatorStatusToContentConverter x:Key="SimulatorStatusToContentConverter"/>

        <Style TargetType="Control">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="Border" x:Key="BaseCard">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8986CC" BlurRadius="15" ShadowDepth="4" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9A97D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="100" CenterY="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="TimeBtnStyle">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.90" ScaleY="0.90" CenterX="15" CenterY="15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ConfigBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource DeepPurple}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ConfigLabel">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AliceBlue}">
        <ContentControl Content="{Binding MainContent}" Visibility="{Binding ContentVisibility}" Panel.ZIndex="10"/>

        <Grid Visibility="{Binding DashboardVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="458*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource DeepPurple}" CornerRadius="0,20,20,0">
                <StackPanel Margin="20,40,20,20">

                    <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,15"
                        BorderBrush="White" BorderThickness="1"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="/Images/logo.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="Hello, Admin" Foreground="{StaticResource TextLight}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                    <Button Content="Main Dashboard" Click="BtnDashboard_Click" Style="{StaticResource MenuButton}" Background="#9A97D9"/>
                    <Button Content="List Management" Click="BtnList_Click" Style="{StaticResource MenuButton}"/>
                    <Button Content="Courier Management" Click="BtnCouriers_Click" Style="{StaticResource MenuButton}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30,30,30,30" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,6,20,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Path Data="M 0,50 Q 40,50 60,30 T 100,50 T 140,70 T 180,50 T 220,50" 
                                  Stroke="{StaticResource DeepPurple}" StrokeThickness="2" Opacity="0.2" Stretch="Fill"/>

                            <Path Data="M 0,50 Q 40,50 60,30 T 100,50 T 140,70 T 180,50" 
                                  Stroke="#00E5FF" StrokeThickness="3" Stretch="Fill" HorizontalAlignment="Left" Width="200">
                                <Path.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                </Path.Effect>
                            </Path>

                            <Ellipse Width="8" Height="8" Fill="#00E5FF" HorizontalAlignment="Left" Margin="196,46,0,0" VerticalAlignment="Top">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <StackPanel VerticalAlignment="Center" Margin="10,-30,0,0">
                                <TextBlock Text="SYSTEM OPERATIONAL" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" Opacity="0.8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Live Tracking" FontSize="22" FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#673AB7" Offset="0"/>
                                                <GradientStop Color="#9575CD" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="📡" FontSize="18" Margin="8,2,0,0" Foreground="#00E5FF">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Style="{StaticResource BaseCard}" Width="280" Height="130">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8986CC" Offset="0.0"/>
                                    <GradientStop Color="#9E8ED6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid ClipToBounds="True">
                                <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5 c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S6.83,18.5,6,18.5z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5 s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z M17,12V9.5h2.5l1.96,2.5H17z"
                                      Fill="White" Opacity="0.1" Stretch="Uniform"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Width="100" Height="100" Margin="0,-15,-15,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-15"/>
                                    </Path.RenderTransform>
                                </Path>

                                <Grid Margin="20,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏱️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Simulator" FontWeight="Bold" Foreground="White" FontSize="22" VerticalAlignment="Center" Effect="{x:Null}"/>
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Border Background="#29B6F6" CornerRadius="6" Padding="8,4"
                                                    Visibility="{Binding IsSimulatorRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,5,0"/>
                                                    <TextBlock Text="ON" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#29B6F6" BlurRadius="10" ShadowDepth="0"/>
                                                </Border.Effect>
                                            </Border>

                                            <Border Background="#30000000" CornerRadius="6" Padding="8,4"
                                                    Visibility="{Binding IsSimulatorNotRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#BBB" Margin="0,0,5,0"/>
                                                    <TextBlock Text="OFF" Foreground="#DDD" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="SPEED (SEC)" FontSize="11" FontWeight="Bold" Foreground="#B2EBF2" Margin="0,0,0,2"/>
                                            <Border CornerRadius="8" Background="#25FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1" Width="75" Height="38">
                                                <TextBox Text="{Binding SimulatorInterval}" IsEnabled="{Binding IsSimulatorNotRunning}"
                                                         Background="Transparent" BorderThickness="0"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                         FontSize="18" FontWeight="Bold" Foreground="White" CaretBrush="White"
                                                         PreviewTextInput="NumberValidationTextBox" MaxLength="5"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="2" Command="{Binding SimulatorCommand}" Click="BtnSimulator_Click" Content="{Binding IsSimulatorRunning, Converter={StaticResource SimulatorStatusToContentConverter}}"
                                                Width="120" Height="42" Background="White" Foreground="{StaticResource DeepPurple}"
                                                FontSize="15" FontWeight="Bold" Cursor="Hand" BorderThickness="0" VerticalAlignment="Bottom">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="5" ShadowDepth="2"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="60" CenterY="21"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource BaseCard}" Background="{StaticResource Lavender}">
                        <Grid Margin="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm:ss}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTime, StringFormat=dd/MM/yyyy}" FontSize="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <Expander Header="Manage Time" HorizontalAlignment="Center" Width="180" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <Button Content="+m" Click="BtnAddMinute_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Style="{StaticResource TimeBtnStyle}" ToolTip="Add Minute"/>
                                        <Button Content="+H" Click="BtnAddHour_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Style="{StaticResource TimeBtnStyle}" ToolTip="Add Hour"/>
                                        <Button Content="+D" Click="BtnAddDay_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Style="{StaticResource TimeBtnStyle}" ToolTip="Add Day"/>
                                        <Button Content="+M" Click="BtnAddMonth_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Style="{StaticResource TimeBtnStyle}" ToolTip="Add Month"/>
                                        <Button Content="+Y" Click="BtnAddYear_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Style="{StaticResource TimeBtnStyle}" ToolTip="Add Year"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Border Style="{StaticResource BaseCard}" Background="{StaticResource GhostWhite}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 Orders Overview" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="(Live Quantities)" FontSize="14" Foreground="Gray" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="5" VerticalAlignment="Bottom" Height="220" Margin="10,20">
                                <StackPanel VerticalAlignment="Bottom" Margin="15,0">
                                    <Grid Height="150" VerticalAlignment="Bottom">
                                        <Border Height="{Binding OpenHeight}" CornerRadius="10,10,0,0" Background="{StaticResource DeepPurple}" Opacity="0.8" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding OpenVal}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Open" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Bottom" Margin="15,0">
                                    <Grid Height="150" VerticalAlignment="Bottom">
                                        <Border Height="{Binding InProgressHeight}" CornerRadius="10,10,0,0" Background="{StaticResource DeepPurple}" Opacity="0.6" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding InProgressVal}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="In Progress" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Bottom" Margin="15,0">
                                    <Grid Height="150" VerticalAlignment="Bottom">
                                        <Border Height="{Binding DeliveredHeight}" CornerRadius="10,10,0,0" Background="{StaticResource DeepPurple}" Opacity="1.0" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding DeliveredVal}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Delivered" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="15" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Bottom" Margin="15,0">
                                    <Grid Height="150" VerticalAlignment="Bottom">
                                        <Border Height="{Binding RefusedHeight}" CornerRadius="10,10,0,0" Background="{StaticResource DeepPurple}" Opacity="0.4" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding RefusedVal}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Refused" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Bottom" Margin="15,0">
                                    <Grid Height="150" VerticalAlignment="Bottom">
                                        <Border Height="{Binding CancelledHeight}" CornerRadius="10,10,0,0" Background="{StaticResource DeepPurple}" Opacity="0.3" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding CancelledVal}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Cancelled" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Height="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Click="BtnInit_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Height="55" Margin="0,0,0,15" Background="{StaticResource DeepPurple}" Foreground="{StaticResource Seashell}" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="Initialize" FontWeight="Bold" FontSize="20"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="100" CenterY="27"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="BtnReset_Click" IsEnabled="{Binding IsSimulatorNotRunning}" Height="55" Margin="0,0,0,15" Background="{StaticResource DeepPurple}" Foreground="{StaticResource Seashell}" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="↻" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" RenderTransformOrigin="0.892,0.424" Margin="0,0,0,2" Height="46"/>
                                            <TextBlock Text="Reset" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="100" CenterY="27"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#9A97D9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource BaseCard}" Background="{StaticResource GhostWhite}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="⚙️ System Configuration" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                            <UniformGrid Grid.Row="1" Columns="4">
                                <StackPanel Margin="5">
                                    <TextBlock Text="👤 Admin ID" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.AdminId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="🔑 Password" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding AdminPasswordInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="🏢 Address" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.CompenyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="📏 Max Dist." Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.DeliveryMaxDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="🔋 Range" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.MaxDeliveryRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="⚠️ Risk Range" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.RiskRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="🚗 Car Speed" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.AverageVehicleSpeedKmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="🏍️ Moto Speed" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.AverageMotorcycleSpeedKmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="🚴 Bike Speed" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.AverageBicycleSpeedKmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="🏃 Foot Speed" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.AverageByFootSpeedKmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="💤 Inactivity" Style="{StaticResource ConfigLabel}"/>
                                    <TextBox Text="{Binding Configuration.InactivityTimeRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigBox}"/>
                                </StackPanel>
                            </UniformGrid>

                            <Button Click="BtnSaveConfig_Click" Grid.Row="2" HorizontalAlignment="Right" Background="{StaticResource DeepPurple}" Foreground="{StaticResource Seashell}" Padding="30,8" Margin="0,10,0,0" BorderThickness="0" Height="35" Width="126" Cursor="Hand" FocusVisualStyle="{x:Null}" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="💾" Margin="0,0,10,0" FontSize="16"/>
                                                <TextBlock Text="Save Config" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="63" CenterY="17"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Grid Visibility="{Binding LoadingVisibility}" Panel.ZIndex="100" Background="#40000000">
            <Border Background="White" 
            CornerRadius="15" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Padding="40,30"
            MinWidth="250">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">

                    <Grid Width="60" Height="60" HorizontalAlignment="Center">
                        <Ellipse Stroke="#7C4DFF" 
                         StrokeThickness="5" 
                         StrokeDashArray="1 1.5" 
                         StrokeDashCap="Round" 
                         RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="Processing..." 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#333333" 
                       Margin="0,20,0,0" 
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Please wait a moment" 
                       FontSize="14" 
                       Foreground="Gray" 
                       Margin="0,5,0,0" 
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>