<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Order Details" Height="690" Width="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/logo.png"
        ResizeMode="NoResize" Background="{StaticResource AliceBlue}">

    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <converters:DeleteVisibilityConverter x:Key="DeleteVisibilityConverterKey"/>
        <converters:ZeroToEmptyStringConverter x:Key="ZeroToEmptyConverterKey"/>
        <converters:BooleanToButtonTitleConverter x:Key="BoolToTitleConverterKey"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <converters:OrderToDeleteVisibilityConverter x:Key="OrderToDeleteVisibilityConverterKey"/>
        
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="ComboBoxItem" x:Key="PurpleComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0DFF5"/>
                                <Setter Property="Foreground" Value="#4A4A6A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8986CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DeliveryDetailsTemplate">
            <Border Background="#F0F8FF" BorderBrush="#8986CC" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,5,0,0">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Left" Margin="0,0,0,10">
                <Run Text="🚚 Delivery Details
                     " FontWeight="Bold" Foreground="#8986CC"/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Courier: " Foreground="Gray" Margin="0,0,5,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="#4A4A6A"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Courier ID: " Foreground="Gray" Margin="0,0,5,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CourierId}" FontWeight="Bold" Foreground="#4A4A6A"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type: " Foreground="Gray" Margin="0,0,5,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TypeOfDelivery}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Time: " Foreground="Gray" Margin="0,0,5,5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding DeliveryStartTime, StringFormat='Start: {0:HH:mm}'}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DeliveryEndTime, StringFormat='End: {0:HH:mm}', TargetNullValue='(In Progress)'}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Distance: " Foreground="Gray" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActualDistance, StringFormat='{}{0:N2} km'}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="15" Background="White" BorderBrush="#8986CC" BorderThickness="1" />
                <Path Grid.Column="1" Fill="#8986CC" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ModernComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="15,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,30,0" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#8986CC" CornerRadius="10" Margin="0,5,0,0">
                            <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox" x:Key="PurpleComboBox">
            <Setter Property="Template" Value="{StaticResource ModernComboBoxTemplate}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PurpleComboBoxItem}"/>
        </Style>

        <Style x:Key="CancelIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Width="24" Height="24" 
                        CornerRadius="12"
                        Background="#FFF5F5"
                        BorderBrush="#FFCDD2"
                        BorderThickness="1">

                            <Path x:Name="icon"
                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                          Fill="#E57373" 
                          Stretch="Uniform" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Width="10" Height="10"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5252"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5252"/>
                                <Setter TargetName="icon" Property="Fill" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" CenterX="12" CenterY="12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8986CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="InfoLabel">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InfoValue">
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DeepPurple}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📦 " FontSize="28" Foreground="White" Margin="0"/>
                <TextBlock Text="{Binding IsUpdateMode, Converter={StaticResource BoolToTitleConverterKey}, StringFormat='{}{0} Order Details'}" 
                           Foreground="White" FontSize="24" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Customer Name"/>
                        <TextBox Text="{Binding CurrentOrder.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEditable}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Customer Phone"/>
                        <TextBox Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEditable}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Full Address"/>
                        <TextBox Text="{Binding CurrentOrder.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEditable}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="Order Type"/>
                        <ComboBox SelectedItem="{Binding CurrentOrder.TypeOfOrder, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                                  ItemsSource="{Binding OrderTypes}"
                                  Style="{StaticResource PurpleComboBox}"
                                  Height="35" Margin="0,0,0,20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2">
                        <TextBlock Text="Verbal Description"/>
                        <TextBox Text="{Binding CurrentOrder.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4">
                        <TextBlock Text="Package Details (Weight, Volume, Fragile...)"/>
                        <TextBox Text="{Binding CurrentOrder.PackageDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"
                                 Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <Border Background="White" CornerRadius="10" Margin="0,20,0,0" Padding="15"
                        Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVisConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#E0E0E0" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="ℹ️ Order Information" FontSize="16" Foreground="#8986CC" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="Order ID" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.Id}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="Status" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.StatusOfOrder}" Style="{StaticResource InfoValue}" Foreground="#8986CC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1">
                                <TextBlock Text="Opened At" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.OrderOpeningTime, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="1">
                                <TextBlock Text="Expected Delivery" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.ExpectedDeliveryTime, StringFormat='dd/MM/yyyy HH:mm', TargetNullValue='Pending'}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="Max Delivery Time" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.MaxDeliveryTime, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource InfoValue}" Foreground="#E53935"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <TextBlock Text="Time Remaining" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.RemainingDeliveryTime, StringFormat='hh\\:mm\\:ss'}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3">
                                <TextBlock Text="Timeliness Status" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CurrentOrder.TimeLinessStatus}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Margin="0,15,0,0">
                                <TextBlock Text="Associated Deliveries" Style="{StaticResource InfoLabel}"/>

                                <ContentControl Content="{Binding CurrentOrder.DeliveryList}" 
                                                ContentTemplate="{StaticResource DeliveryDetailsTemplate}"
                                                Visibility="{Binding CurrentOrder.DeliveryList, Converter={StaticResource NullToVisConverter}}"/>

                                <TextBlock Text="No deliveries yet" 
                                           Visibility="{Binding CurrentOrder.DeliveryList, Converter={StaticResource NullToVisConverter}, ConverterParameter=Invert}" 
                                           Style="{StaticResource InfoValue}" FontStyle="Italic" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="BtnCancelOrder_Click"
                    Visibility="{Binding CurrentOrder, Converter={StaticResource OrderToDeleteVisibilityConverterKey}}"
                    Style="{StaticResource CancelIconButtonStyle}"
                    HorizontalAlignment="Left" 
                    Margin="25,0,0,0"
                    ToolTip="Cancel Order" Grid.ColumnSpan="2" Width="54"/>

            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding IsUpdateMode, Converter={StaticResource BoolToTitleConverterKey}}" 
                        Click="BtnAddUpdate_Click" IsEnabled="{Binding IsEditable}"
                        Width="140" Height="45" Margin="10" IsDefault="True"
                        Background="{StaticResource DeepPurple}" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Cancel" IsCancel="True"
                        Click="BtnCancel_Click" 
                        Width="140" Height="45" Margin="10"
                        Background="White" Foreground="{StaticResource DeepPurple}" FontWeight="Bold" FontSize="16"
                        BorderBrush="{StaticResource DeepPurple}" BorderThickness="2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>