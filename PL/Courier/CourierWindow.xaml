<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Courier Details" Height="690" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{StaticResource AliceBlue}">

    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>

        <converters:DeleteVisibilityConverter x:Key="DeleteVisibilityConverterKey"/>
        <converters:ZeroToEmptyStringConverter x:Key="ZeroToEmptyConverterKey"/>
        <converters:BooleanToButtonTitleConverter x:Key="BoolToTitleConverterKey"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="ComboBoxItem" x:Key="PurpleComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0DFF5"/>
                                <Setter Property="Foreground" Value="#4A4A6A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8986CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TrashButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="50" Width="45" Height="45">
                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                  Fill="#FFF43939" 
                                  Stretch="Uniform" 
                                  Margin="0,10,0,0" HorizontalAlignment="Center" Width="25" Height="25" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" CenterX="22.5" CenterY="22.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8986CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="15" Background="White" BorderBrush="#8986CC" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8986CC" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ModernComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="15,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,30,0" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#8986CC" CornerRadius="10" Margin="0,5,0,0">
                            <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox" x:Key="PurpleComboBox">
            <Setter Property="Template" Value="{StaticResource ModernComboBoxTemplate}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="ItemContainerStyle" Value="{StaticResource PurpleComboBoxItem}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <DataTemplate x:Key="OrderDetailsTemplate">
            <Border Background="#F0F8FF" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Run Text="📦 Order #" FontSize="20" FontWeight="Bold" Foreground="#8986CC"/>
                            <Run Text="{Binding OrderId}" FontSize="20" FontWeight="Bold" Foreground="#8986CC"/>
                            <Run Text=" Details" FontSize="20" FontWeight="Bold" Foreground="#8986CC"/>
                        </TextBlock>

                        <ItemsControl>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Order Type: " Foreground="Gray"/>
                                <TextBlock Text="{Binding TypeOfOrder}" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Status: " Foreground="Gray"/>
                                <TextBlock Text="{Binding StatusOfOrder}" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Timeliness Status: " Foreground="Gray"/>
                                <TextBlock Text="{Binding TimeLinessStatus}" FontWeight="Bold" Foreground="#4A4A6A"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Description:" Foreground="Gray"/>
                                <TextBlock Text="{Binding Description}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,10"/>

                            <StackPanel Margin="0,5">
                                <TextBlock Text="Customer Name: " Foreground="Gray"/>
                                <TextBlock Text="{Binding CustomerName}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Customer Phone: " Foreground="Gray"/>
                                <TextBlock Text="{Binding CustomerPhone}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Address: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Address}" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator Margin="0,10"/>

                            <StackPanel Margin="0,5">
                                <TextBlock Text="Order Opening Time: " Foreground="Gray"/>
                                <TextBlock Text="{Binding OrderOpeningTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Delivery Start Time: " Foreground="Gray"/>
                                <TextBlock Text="{Binding DeliveryStartTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Expected Delivery: " Foreground="Gray"/>
                                <TextBlock Text="{Binding ExpectedDeliveryTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Max Delivery Time: " Foreground="Gray"/>
                                <TextBlock Text="{Binding MaxDeliveryTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold" Foreground="Red"/>
                            </StackPanel>

                            <StackPanel Margin="0,5">
                                <TextBlock Text="Remaining Time: " Foreground="Gray"/>
                                <TextBlock Text="{Binding RemainingDeliveryTime, StringFormat='hh\\:mm\\:ss'}" FontWeight="Bold" Foreground="#8986CC"/>
                            </StackPanel>

                            <Separator Margin="0,10"/>

                            <StackPanel Margin="0,5">
                                <TextBlock Text="Air Distance: " Foreground="Gray"/>
                                <TextBlock Text="{Binding AirDistance, StringFormat={}{0:N2} km}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="Actual Distance: " Foreground="Gray"/>
                                <TextBlock Text="{Binding ActualDistance, TargetNullValue='N/A', StringFormat={}{0:N2} km}" FontWeight="Bold"/>
                            </StackPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DeepPurple}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🚚 " FontSize="28" Foreground="White" Margin="0"/>
                    <TextBlock Text="{Binding IsUpdateMode, Converter={StaticResource BoolToTitleConverterKey}, StringFormat='{}{0} Courier Details'}" 
                               Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="{Binding CurrentCourier.StartWorkTime, StringFormat='Member Since: {0:dd/MM/yyyy}'}"
                           Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVisConverter}}"
                           Foreground="#E0E0E0" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <TextBlock Text="ID Number"/>
                <TextBox Text="{Binding CurrentCourier.Id, Converter={StaticResource ZeroToEmptyConverterKey}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                         IsReadOnly="{Binding IsUpdateMode, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0">
                <TextBlock Text="Full Name"/>
                <TextBox Text="{Binding CurrentCourier.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="1">
                <TextBlock Text="Phone Number"/>
                <TextBox Text="{Binding CurrentCourier.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1">
                <TextBlock Text="Email Address"/>
                <TextBox Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Password"/>
                <TextBox Text="{Binding CurrentCourier.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Activity"/>
                <Border CornerRadius="15" Background="White" BorderBrush="#8986CC" BorderThickness="1" Height="35" Margin="0,0,0,20">
                    <CheckBox IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              VerticalAlignment="Center" 
                              Margin="10,0" 
                              Content="Is Active" 
                              Foreground="#4A4A6A"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">
                <TextBlock Text="Shipping Type"/>
                <ComboBox SelectedItem="{Binding CurrentCourier.TypeOfDelivery, Mode=TwoWay}"
                          ItemsSource="{Binding DeliveryTypes}"
                          Style="{StaticResource PurpleComboBox}"
                          Height="35" Margin="0,0,0,20"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="3" VerticalAlignment="Center">
                <TextBlock Text="Max Distance"/>
                <TextBox Text="{Binding CurrentCourier.MaxDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="4">
                <TextBlock Text="On-Time Deliveries"/>
                <TextBox Text="{Binding CurrentCourier.TotalOnTimeDeliveries, Mode=OneWay}"
                         IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="4">
                <TextBlock Text="Late Deliveries"/>
                <TextBox Text="{Binding CurrentCourier.TotalLateDeliveries, Mode=OneWay}"
                         IsReadOnly="True"/>
            </StackPanel>

            <Button Grid.Row="6" Grid.ColumnSpan="3"
                    Content="📄 View Current Order Details"
                    Click="BtnViewOrder_Click"
                    Visibility="{Binding CurrentCourier.CurrentOrder, Converter={StaticResource NullToVisConverter}}"
                    Height="40" Margin="0,15,0,0"
                    Background="White" Foreground="#8986CC" FontWeight="Bold" FontSize="14"
                    BorderBrush="#8986CC" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="BtnDelete_Click"
                    Visibility="{Binding CurrentCourier, Converter={StaticResource DeleteVisibilityConverterKey}}"
                    Style="{StaticResource TrashButtonStyle}"
                    HorizontalAlignment="Left" 
                    Margin="25,0,0,0"
                    ToolTip="Delete Courier"/>

            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding IsUpdateMode, Converter={StaticResource BoolToTitleConverterKey}}" 
                        Click="BtnAddUpdate_Click"
                        Width="140" Height="45" Margin="10"
                        Background="{StaticResource DeepPurple}" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Cancel" IsCancel="True"
                        Width="140" Height="45" Margin="10"
                        Background="White" Foreground="{StaticResource DeepPurple}" FontWeight="Bold" FontSize="16"
                        BorderBrush="{StaticResource DeepPurple}" BorderThickness="2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>