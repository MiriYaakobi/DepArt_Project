<UserControl x:Class="PL.Courier.CourierHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="GhostWhite" Color="#F8F8FF"/>
        <SolidColorBrush x:Key="AliceBlue" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="TextDark" Color="#4A4A6A"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>

        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9A97D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="DeliveryCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource AliceBlue}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DeepPurple}" CornerRadius="0,20,20,0">
            <StackPanel Margin="20,40,20,20">
                <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,15"
                        BorderBrush="White" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="/Images/logo.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <TextBlock Text="Hello, Courier" Foreground="{StaticResource TextLight}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Button Content="🏠 Dashboard" Click="BtnDashboard_Click" Style="{StaticResource MenuButton}"/>

                <Button Content="📜 Delivery History" Style="{StaticResource MenuButton}" Background="#706DB3" IsHitTestVisible="False"/>

                <Button Content="📦 Pick New Order" Click="BtnPickOrder_Click" Style="{StaticResource MenuButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Delivery History" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filter by Status:" VerticalAlignment="Center" Foreground="#808080" Margin="0,0,10,0"/>

                    <ComboBox Width="150" Height="30"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              SelectionChanged="Filter_SelectionChanged"
                              VerticalContentAlignment="Center" Padding="5">
                    </ComboBox>

                    <Button Content="Clear Filter" Click="BtnClearFilter_Click" 
                            Margin="15,0,0,0" Padding="10,0" Background="Transparent" BorderBrush="{StaticResource DeepPurple}" BorderThickness="1" Foreground="{StaticResource DeepPurple}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding DeliveriesList}" 
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DeliveryCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" Background="#F0F8FF" Margin="0,0,15,0">
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Order #" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" FontSize="16"/>
                                        <TextBlock Text="{Binding OrderId}" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" FontSize="16"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Address}" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" FontSize="14"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Type: " FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding TypeOfDelivery}" FontSize="12" FontWeight="SemiBold" Foreground="#4A4A6A" Margin="0,0,10,0"/>

                                        <TextBlock Text="Time: " FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding DeliveryEndTime, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="12" FontWeight="SemiBold" Foreground="#4A4A6A"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" Padding="10,5" CornerRadius="8" Background="{StaticResource DeepPurple}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OrderClosedStatus}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="1" Text="No history found matching your criteria." 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                       Foreground="Gray" FontSize="16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeliveriesList.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>
    </Grid>
</UserControl>