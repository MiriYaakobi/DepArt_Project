<UserControl x:Class="PL.Courier.CourierPickOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PL" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="GhostWhite" Color="#F8F8FF"/>
        <SolidColorBrush x:Key="AliceBlue" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="TextDark" Color="#4A4A6A"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#4CAF50"/>

        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9A97D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="OrderCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="BaseCard">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{StaticResource GhostWhite}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8986CC" BlurRadius="15" ShadowDepth="4" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PickButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#8986CC"/>
            <Setter Property="BorderBrush" Value="#8986CC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="shadow" CornerRadius="20" Background="Black" Margin="0,2,0,0" Opacity="0.1">
                                <Border.Effect>
                                    <BlurEffect Radius="5"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8986CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="50" CenterY="15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="shadow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="10" Background="White" BorderBrush="#8986CC" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8986CC" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#F0F8FF"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#6A5ACD"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6E6FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8986CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ModernComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="15,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,30,0" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#8986CC" CornerRadius="10" Margin="0,5,0,0">
                            <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox" x:Key="PurpleComboBox">
            <Setter Property="Template" Value="{StaticResource ModernComboBoxTemplate}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource AliceBlue}" DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DeepPurple}" CornerRadius="0,20,20,0">
            <StackPanel Margin="20,40,20,20">
                <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,15"
                        BorderBrush="White" BorderThickness="1"
                        RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <ImageBrush ImageSource="/Images/logo.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <TextBlock Text="{Binding CurrentCourier.Name, StringFormat='Hello, {0}'}" 
                           Foreground="{StaticResource TextLight}" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock Text="{Binding CurrentCourier.StartWorkTime, StringFormat='Member Since: {0:dd/MM/yyyy}'}"
                           Foreground="{StaticResource TextLight}" FontSize="12" Opacity="0.8"
                           HorizontalAlignment="Center" Margin="0,5,0,40"/>

                <Button Content="Dashboard" Click="BtnDashboard_Click" Style="{StaticResource MenuButton}"/>

                <Button Content="Delivery History" Click="BtnHistory_Click" Style="{StaticResource MenuButton}"/>

                <Button Content="Pick New Order" Background="#9A97D9" IsHitTestVisible="False" Style="{StaticResource MenuButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Find Available Orders" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                <Border Style="{StaticResource BaseCard}" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📏 Sort Orders By:" Foreground="{StaticResource TextDark}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox Width="180" Height="35"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}"
                                  Style="{StaticResource PurpleComboBox}"
                                  VerticalContentAlignment="Center" Padding="5"/>

                        <TextBlock Text="(Showing orders within your max distance)" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding OrdersList}" 
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource OrderCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="15" Background="#F0F8FF" Margin="0,0,20,0">
                                    <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Order #" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" FontSize="18"/>
                                        <TextBlock Text="{Binding OrderId}" FontWeight="Bold" Foreground="{StaticResource DeepPurple}" FontSize="18"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Address}" Foreground="#4A4A6A" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="15" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PackageDetails}" Foreground="Gray" TextTrimming="CharacterEllipsis" FontSize="13"/>

                                    <TextBlock Text="{Binding TypeOfOrder}" Foreground="#4A4A6A" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="15" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding TimeLinessStatus}" Foreground="Gray" TextTrimming="CharacterEllipsis" FontSize="13"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="📏 Distance: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding AirDistance, StringFormat={}{0:F1} km}" FontWeight="Bold" Foreground="#4A4A6A"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏳ Time Left: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding RemainingTime, StringFormat={}{0:hh\\:mm}}" FontWeight="Bold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="3" Content="Pick Order" 
                                        Click="BtnPick_Click"
                                        Style="{StaticResource PickButtonStyle}"
                                        VerticalAlignment="Center"
                                        CommandParameter="{Binding OrderId}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="1" Text="No available orders found nearby." 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                       Foreground="Gray" FontSize="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OrdersList.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>