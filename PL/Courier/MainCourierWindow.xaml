<Window x:Class="PL.Courier.MainCourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:BO="clr-namespace:BO;assembly=BL"
        xmlns:converters="clr-namespace:PL" 
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="850" Width="1400"
        Icon="/Images/logo.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AliceBlue}">

    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9A97D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8986CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="10" Background="White" BorderBrush="#8986CC" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8986CC" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#F0F8FF"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#6A5ACD"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6E6FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8986CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ModernComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="15,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,30,0" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#8986CC" CornerRadius="10" Margin="0,5,0,0">
                            <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox" x:Key="PurpleComboBox">
            <Setter Property="Template" Value="{StaticResource ModernComboBoxTemplate}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#4A4A6A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        </Style>

        <ObjectDataProvider x:Key="OrderEndStatusProvider" 
                        MethodName="GetValues" 
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="BO:OrderEndStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <DataTemplate x:Key="ActiveOrderTemplate">
            <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📦 Mission Details" FontSize="18" FontWeight="Bold" Foreground="#8986CC"/>
                        <TextBlock Text="{Binding OrderId, StringFormat=' #{0}'}" FontSize="18" FontWeight="Bold" Foreground="#8986CC"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerName}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Phone: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding CustomerPhone}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Address: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Address}" FontWeight="Bold" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Type: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding TypeOfOrder}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Air Distance: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AirDistance, StringFormat='{}{0:F2} km'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Actual Distance: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding ActualDistance, StringFormat='{}{0:F2} km', TargetNullValue='-'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Start Time: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeliveryStartTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Expected: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding ExpectedDeliveryTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Deadline: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MaxDeliveryTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold" Foreground="#D32F2F"/>

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Time Left: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding RemainingDeliveryTime, StringFormat='{}{0:%d\\.hh\\:mm}'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Open At : " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding OrderOpeningTime, StringFormat='dd/MM/yy HH:mm'}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Description: " Style="{StaticResource LabelStyle}" Margin="0,35,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Description, TargetNullValue='No description'}" 
                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,35,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Timeliness: " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4" Text="{Binding TimeLinessStatus}"  FontWeight="Bold"/>

                    </Grid>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Update Status &amp; Finish:" Style="{StaticResource LabelStyle}" Margin="0,5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Source={StaticResource OrderEndStatusProvider}}"
                                  SelectedItem="{Binding SelectedEndStatus, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Style="{StaticResource PurpleComboBox}" 
                                  Height="40" Margin="0,0,10,0"/>

                        <Button Grid.Column="1" Content="✅ Finish" Click="BtnFinishOrder_Click"
                        Width="100" Height="40"
                        Background="#8986CC" Foreground="White" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding MainViewContent}"  Visibility="{Binding ContentVisibility}" Panel.ZIndex="100"/>
        <Grid Visibility="{Binding DashboardVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource DeepPurple}" CornerRadius="0,20,20,0">
                <StackPanel Margin="20,40,20,20">
                    <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,15"
                            BorderBrush="White" BorderThickness="1" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="/Images/logo.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="{Binding CurrentCourier.Name, StringFormat='Hello, {0}'}" 
                               Foreground="{StaticResource TextLight}" FontSize="22" FontWeight="Bold" 
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentCourier.StartWorkTime, StringFormat='Member Since: {0:dd/MM/yyyy}'}"
                               Foreground="{StaticResource TextLight}" FontSize="12" Opacity="0.8"
                               HorizontalAlignment="Center" Margin="0,5,0,40"/>

                    <Button Content="Dashboard" Background="#9A97D9" IsHitTestVisible="False" Style="{StaticResource MenuButton}"/>

                    <Button Content="Delivery History" Click="BtnHistory_Click" Style="{StaticResource MenuButton}"/>

                    <Button Content="Pick New Order" Click="BtnFindOrder_Click" Style="{StaticResource MenuButton}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,20,0" Background="White" CornerRadius="15" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect Color="#E0E0E0" BlurRadius="10" Opacity="0.5"/>
                    </Border.Effect>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="👤 My Profile" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DeepPurple}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                                    <TextBlock Text="ID" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding CurrentCourier.Id, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputStyle}" Foreground="Gray"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,0">
                                    <TextBlock Text="Activity" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding CurrentCourier.IsActive, StringFormat='Active: {0}'}" IsReadOnly="True" Style="{StaticResource InputStyle}" Foreground="Gray"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.Name}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.Phone}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.Email}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding VisualPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" 
                                     Margin="0,0,0,5" PreviewTextInput="Password_PreviewTextInput" PreviewKeyDown="Password_PreviewKeyDown">
                                <TextBox.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Copy" CanExecute="CommandBinding_CanExecute"/>
                                    <CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute"/>
                                    <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute"/>
                                </TextBox.CommandBindings>
                            </TextBox>

                            <TextBlock Text="Shipping Type" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding DeliveryTypes}" SelectedItem="{Binding CurrentCourier.TypeOfDelivery}" 
                                      Style="{StaticResource PurpleComboBox}" Height="35" Margin="0,0,0,15"/>

                            <TextBlock Text="Max Distance (km)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.MaxDistance}" Style="{StaticResource InputStyle}" Margin="0,0,0,25"/>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="On-Time Deliveries" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding CurrentCourier.TotalOnTimeDeliveries}" IsReadOnly="True" Style="{StaticResource InputStyle}" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Late Deliveries" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding CurrentCourier.TotalLateDeliveries}" IsReadOnly="True" Style="{StaticResource InputStyle}" Foreground="Gray"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="Update Details" Click="BtnUpdate_Click"
                                    Background="{StaticResource DeepPurple}" Foreground="White" FontWeight="Bold" Height="45" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Content="{Binding CurrentCourier.CurrentOrder}"
                                    ContentTemplate="{StaticResource ActiveOrderTemplate}"
                                    Visibility="{Binding CurrentCourier.CurrentOrder, Converter={StaticResource NullToVisConverter}}"/>

                    <Border Grid.Row="0" Background="#F9F9FF" CornerRadius="15" Padding="15"
                            Visibility="{Binding CurrentCourier.CurrentOrder, Converter={StaticResource NullToVisConverter}, ConverterParameter=Invert}">
                        <Border BorderBrush="#8986CC" BorderThickness="1" CornerRadius="15" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Ready for Mission?" FontSize="20" FontWeight="Bold" Foreground="#4A4A6A" HorizontalAlignment="Center"/>
                                <TextBlock Text="No active order at the moment." Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Row="1" CornerRadius="15" Padding="0" Margin="0,24,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                            <Image Source="/Images/courier.png" Width="300" Height="300" Stretch="Uniform" Margin="0,0,0,15"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>