<Window x:Class="PL.Courier.MainCourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PL" 
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource AliceBlue}">

    <Window.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>

        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8986CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ActiveOrderTemplate">
            <Border Background="White" CornerRadius="15" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📦 Current Order" FontSize="18" FontWeight="Bold" Foreground="#8986CC" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Order ID:" Style="{StaticResource LabelStyle}" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Text="Address:" Style="{StaticResource LabelStyle}" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeliveryAddress}" FontWeight="Bold" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Text="Customer:" Style="{StaticResource LabelStyle}" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CustomerName}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Text="Pick Up:" Style="{StaticResource LabelStyle}" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrderOpeningTime, StringFormat='HH:mm'}" FontWeight="Bold"/>
                    </Grid>

                    <Separator Margin="0,15"/>
                    <TextBlock Text="Report Status to Finish:" Style="{StaticResource LabelStyle}"/>

                    <ComboBox x:Name="CmbEndStatus" Height="35" Margin="0,5,0,15"
                              DisplayMemberPath="Name" SelectedValuePath="Value"/>

                    <Button Content="✅ Finish Handling" Click="BtnFinishOrder_Click"
                            Background="#8986CC" Foreground="White" FontWeight="Bold" Height="40">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource DeepPurple}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="👋 Hello, " FontSize="24" Foreground="White"/>
                    <TextBlock Text="{Binding CurrentCourier.Name}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Button Content="Logout" HorizontalAlignment="Right" Margin="20,0"
                        Click="BtnLogout_Click"
                        Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="White" Padding="15,5">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="20" Background="White" CornerRadius="15" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#E0E0E0" BlurRadius="10" Opacity="0.5"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="👤 My Profile" FontSize="18" FontWeight="Bold" Foreground="#4A4A6A" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Courier ID" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.Id, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputStyle}" Background="#F5F5F5" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Active Status" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CurrentCourier.IsActive}" IsReadOnly="True" Style="{StaticResource InputStyle}" Background="#F5F5F5" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentCourier.Name}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentCourier.Phone}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentCourier.Email}" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Vehicle Type" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="CmbVehicle" 
                              SelectedItem="{Binding CurrentCourier.TypeOfDelivery}" 
                              Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="Max Distance (km)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentCourier.MaxDistance}" Style="{StaticResource InputStyle}" Margin="0,0,0,25"/>

                    <Button Content="Update Details" Click="BtnUpdate_Click"
                            Background="#4A4A6A" Foreground="White" FontWeight="Bold" Height="45" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Separator Margin="0,20"/>

                    <Button Content="📜 View Delivery History" Click="BtnHistory_Click"
                            Background="White" Foreground="#4A4A6A" BorderBrush="#4A4A6A" BorderThickness="1" Height="40" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,20,20,20">

            <ContentControl Content="{Binding CurrentCourier.CurrentOrder}"
                            ContentTemplate="{StaticResource ActiveOrderTemplate}"
                            Visibility="{Binding CurrentCourier.CurrentOrder, Converter={StaticResource NullToVisConverter}}"/>

            <Border Background="#F9F9FF" CornerRadius="15" 
                    Visibility="{Binding CurrentCourier.CurrentOrder, Converter={StaticResource NullToVisConverter}, ConverterParameter=Invert}">
                <Border borderBrush="#8986CC" BorderThickness="1" borderStyle="Dashed" CornerRadius="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No Active Orders" FontSize="20" FontWeight="Bold" Foreground="#4A4A6A" HorizontalAlignment="Center"/>
                        <TextBlock Text="You are free to take a new task!" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <Button Content="🔎 Find New Order" Click="BtnFindOrder_Click"
                                IsEnabled="{Binding CurrentCourier.IsActive}"
                                Width="200" Height="50"
                                Background="#8986CC" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="25"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="You must be 'Active' to take orders." 
                                   Visibility="{Binding CurrentCourier.IsActive, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"
                                   Foreground="Red" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>