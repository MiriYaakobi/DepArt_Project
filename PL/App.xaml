<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             xmlns:converters="clr-namespace:PL"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DeepPurple" Color="#8986CC"/>
        <SolidColorBrush x:Key="GhostWhite" Color="#F8F8FF"/>
        <SolidColorBrush x:Key="AliceBlue" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="Seashell" Color="#FFF5EE"/>
        <SolidColorBrush x:Key="TextDark" Color="#4A4A6A"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>

        <converters:StatusToColorConverter x:Key="StatusToColorConverterKey"/>
        <converters:IdToContentConverter x:Key="IdToContentConverterKey"/>
        <converters:IdToIsReadOnlyConverter x:Key="IdToIsReadOnlyConverterKey"/>
    </Application.Resources>
</Application>